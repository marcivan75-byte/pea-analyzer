{
  "version": "V2_2026_08_12_BIAS_SAFE",
  "mode": "VIRTUAL_RESEARCH_ONLY",
  "initial_capital_eur": 100000.0,
  "max_total_exposure_pct": 80.0,
  "cash_buffer_min_pct": 20.0,
  "max_position_pct": 5.0,
  "max_instrument_exposure_pct": 5.0,
  "max_sector_exposure_pct": 20.0,
  "max_open_positions": 20,
  "max_daily_turnover_pct": 20.0,
  "risk_budget_per_position_pct": 0.75,
  "transaction_cost_per_side_pct": 0.25,
