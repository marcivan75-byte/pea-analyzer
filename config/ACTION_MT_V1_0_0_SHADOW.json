  "exit_policy": {
    "hard_stop_return": -0.18,
    "trailing_stop_activation_sessions": 40,
    "trailing_stop_return": -0.12,
    "maximum_holding_sessions": 252,
    "fixed_take_profit_enabled": false
  },
  "governance": {
    "mode": "SHADOW_ONLY",
    "real_orders_enabled": false,
    "structural_snapshot_can_promote_signal": false,
    "holdout_locked": true,
    "certification_required_before_production": true,
    "fixed_take_profit_enabled": false,
    "decision_influence": 0.0,
    "sizing_influence": 0.0
  },
  "runtime": {
    "maximum_workers": 8,
    "target_wall_clock_seconds_400_actions": 90,
    "cache_download_fallback_enabled": false,
    "pit_ledger_idempotent": true
  }
