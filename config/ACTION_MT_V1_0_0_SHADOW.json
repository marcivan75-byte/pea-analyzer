    "current_snapshot_fields_cannot_reconstruct_history": true
  },
  "score_weights": {
    "trend": 0.16,
    "momentum": 0.12,
    "quality": 0.14,
    "growth": 0.09,
    "valuation": 0.08,
    "revisions": 0.07,
    "sector_macro": 0.06,
    "risk": 0.10,
    "liquidity": 0.03,
    "efficiency": 0.05,
    "risk_adjusted": 0.06,
    "volume_confirmation": 0.04
  },
  "gates": {
    "minimum_score_coverage": 0.72,
    "minimum_median_turnover_eur": 500000,
    "preferred_median_turnover_eur": 3000000,
    "maximum_drawdown_block_pct": -45.0,
    "minimum_market_regime_score": 35.0,
    "entry_ready_score": 62.0,
    "entry_strong_score": 74.0,
    "entry_ready_min_confirmations": 4,
    "entry_strong_min_confirmations": 5,
    "earnings_caution_days": 7
  },
  "portfolio_decision": {
    "score_raw_weight": 0.55,
