{
  "version": "18.2.0",
  "base": "18.1.0",
  "theme": "COMPLETENESS_FIRST",
  "primary_bulk_source": "yfinance",
  "no_repeat_api_request_policy": true,
  "api_keys": {
    "MARKETSTACK_API_KEY": "environment",
    "OPENFIGI_API_KEY": "environment",
    "ALPHA_VANTAGE_API_KEY": "environment",
    "FINNHUB_API_KEY": "environment",
    "FRED_API_KEY": "environment",
    "EIA_API_KEY": "environment"
  },
  "source_activation": {
    "operational_and_tested": [
      "yfinance",
      "OpenFIGI v3",
      "Marketstack v2",
      "Alpha Vantage TIME_SERIES_DAILY",
      "Finnhub",
      "FRED",
      "EIA"
    ],
    "planned_public_or_official_fallback_not_configured": [
      "Boursorama",
      "Zonebourse",
      "ABC Bourse",
      "Issuer/KID/Factsheet scraping",
      "AMF/Euronext event ingestion",
      "Morningstar-authorized source",
      "GDELT"
    ]
  },
  "yfinance": {
    "enabled": true,
    "requires_key": false,
    "history_period": "5y",
    "interval": "1d",
    "auto_adjust": true,
    "actions_batch_size": 100,
    "etf_batch_size": 50,
    "threads": true,
    "retry_count": 3,
    "cache_days": 1,
    "fundamental_refresh_days": 7,
    "history_retry_count": 2,
    "history_retry_backoff_seconds": 30,
    "history_retry_batch_size": 25,
    "history_batch_delay_seconds": 0.8,
    "history_min_rows": 20,
    "history_serial_rescue_attempts": 2,
    "history_serial_rescue_backoff_seconds": 90,
    "history_serial_rescue_batch_size": 5,
    "history_serial_rescue_batch_delay_seconds": 1.5,
    "info_delay_seconds": 0.9,
    "info_initial_cooldown_seconds": 75,
    "info_max_retries": 2,
    "info_rate_limit_backoff_seconds": 20,
    "info_max_consecutive_rate_limits": 3
  },
  "openfigi": {
    "enabled": true,
    "api_version": "v3",
    "cache_master_map": true,
    "use_for_symbol_repair": true,
    "authenticated_batch_size": 100,
    "anonymous_batch_size": 5,
    "negative_cache_days": 30,
    "mapping_strategy": "ISIN_PLUS_EXPECTED_MIC"
  },
  "marketstack": {
    "enabled": true,
    "endpoint": "/v2/eod",
    "ticker_list_endpoint": "/v2/tickerslist",
    "history_days": 365,
    "max_symbols_per_run": 3,
    "max_new_symbol_resolutions_per_run": 1,
    "symbol_min_confidence": 0.72,
    "symbol_resolved_ttl_days": 90,
    "symbol_negative_ttl_days": 30,
    "min_rows": 60,
    "delay_seconds": 0.25,
    "require_exact_exchange_mic": true,
    "quota_policy": "CONSERVATIVE_FREE_PLAN_DEFAULT",
    "quota_note": "Actions and ETF share one global process budget: maximum 3 EOD requests plus 1 new ticker-resolution request per run."
  },
  "alpha_vantage": {
    "enabled": true,
    "purpose": "global daily OHLCV fallback after Yahoo/OpenFIGI and Marketstack",
    "function": "TIME_SERIES_DAILY",
    "outputsize": "compact",
    "history_min_rows": 60,
    "max_securities_per_run": 1,
    "max_api_calls_per_selected_security": 4,
    "standard_daily_allowance_assumption": 25,
    "symbol_min_match_score": 0.70,
    "symbol_positive_ttl_days": 90,
    "symbol_negative_ttl_days": 30,
    "delay_seconds": 1.15,
    "per_second_throttle_retries": 2,
    "fundamentals_enabled": false,
    "quota_policy": "CONSERVATIVE_STANDARD_PLAN",
    "quota_note": "At most one failed security is selected across Actions+ETF. A new symbol normally consumes one search plus one daily-history call; cached symbols use only the history call. Calls are spaced by at least 1.05 seconds."
  },
  "fred": {
    "enabled": true,
    "series": {
      "macro_vix": "VIXCLS",
      "macro_curve_10y2y": "T10Y2Y"
    },
    "purpose": "official macro context"
  },
  "eia": {
    "enabled": true,
    "api_version": "v2",
    "series": {
      "wti_spot_usd_bbl": "PET.RWTC.D",
      "brent_spot_usd_bbl": "PET.RBRTE.D"
    },
    "purpose": "official energy context"
  },
  "derived_features": [
    "perf_1m_pct",
    "perf_3m_pct",
    "perf_6m_pct",
    "perf_1y_pct",
    "perf_3y_pct",
    "perf_5y_pct",
    "mm20",
    "mm50",
    "mm100",
    "mm200",
    "rsi14",
    "macd",
    "macd_signal",
    "macd_hist",
    "atr14",
    "bb_mid",
    "bb_upper",
    "bb_lower",
    "rvol20",
    "volatility_20d",
    "volatility_60d",
    "max_drawdown_1y",
    "relative_strength",
    "positive_reversal_flag"
  ],
  "fallback_policy": [
    ["IDENTIFIERS", "OpenFIGI v3 ISIN+MIC [OPERATIONAL]", "Issuer/Euronext [PLANNED]", ""],
    ["OHLCV", "yfinance [OPERATIONAL]", "OpenFIGI symbol repair + yfinance [OPERATIONAL]", "Marketstack v2 [OPERATIONAL]", "Alpha Vantage TIME_SERIES_DAILY [OPERATIONAL]", "Issuer/Euronext [PLANNED]"],
    ["FUNDAMENTALS_ACTIONS", "yfinance [OPERATIONAL]", "Issuer [PLANNED]", "Zonebourse [PLANNED]", "", ""],
    ["CONSENSUS_ACTIONS", "yfinance [OPERATIONAL]", "Finnhub [OPERATIONAL]", "Boursorama [PLANNED]", "Zonebourse [PLANNED]"],
    ["ETF_COSTS_AUM", "ABC Bourse [PLANNED]", "Issuer/KID [PLANNED]", "Boursorama [PLANNED]", ""],
    ["ETF_MORNINGSTAR", "Boursorama [PLANNED]", "Morningstar-authorized source [PLANNED]", "", ""],
    ["NEWS_EVENTS", "AMF/Issuer [PLANNED]", "Finnhub news [PLANNED]", "GDELT [PLANNED]", "Boursorama/Zonebourse [PLANNED]"],
    ["MACRO", "FRED [OPERATIONAL]", "", "", ""],
    ["ENERGY", "EIA [OPERATIONAL]", "", "", ""]
  ],
  "merge_policy": {
    "primary_key": "isin",
    "never_replace_observed_with_missing": true,
    "prefer_higher_evidence": true,
    "prefer_fresher_equal_evidence": true,
    "quarantine_conflicts": true,
    "persist_field_level_provenance": true
  },
  "execution_gate": "SHADOW_BLOCKED",
  "quality_gates": {
    "actions_min_rows": 1486,
    "etf_min_rows": 102,
    "ticker_coverage_min_pct": 100.0,
    "ohlcv_success_min_pct": 90.0,
    "coverage_regression_tolerance_points": 0.0,
    "block_on_empty_output": true,
    "block_on_duplicate_isin": true,
    "fundamentals_availability_min_pct": 90.0,
    "consensus_availability_min_pct": 90.0,
    "openfigi_mapping_coverage_min_pct": 70.0,
    "openfigi_transient_failure_max_pct": 25.0,
    "fail_active_api_on_runtime_error": true
  },
  "automation": {
    "daily_run_id_utc": true,
    "checkpoint_scope": "PER_RUN",
    "publish_excel_artifacts": true,
    "publish_via_pull_request": true,
    "commit_direct_to_default_branch": false
  },
  "finnhub": {
    "delay_seconds": 1.05,
    "max_retries": 2,
    "resolve_symbols_by_isin": true,
    "cache_symbol_map": true,
    "resolved_cache_ttl_days": 90,
    "unresolved_cache_ttl_days": 30,
    "lookup_min_score": 8
  }
}
