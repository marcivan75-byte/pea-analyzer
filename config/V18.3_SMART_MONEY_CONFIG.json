    "z20_sensitivity": 0.3,
    "require_nav_adjustment": true,
    "aum_change_alone_forbidden": true,
    "min_history_observations": 20,
    "max_snapshot_age_days": 10,
    "winsorize_daily_flow_pct": 0.12
  },
  "confidence": {
    "floor": 0.0,
    "low_threshold": 0.65,
    "low_confidence_effective_cap": 1.75
  },
  "decision_gates": {
    "base_score_min_for_shortlist_promotion": 60,
    "require_technical_confirmation_for_buy": true,
    "mandatory_risk_review_wis_lte": -3.5,
    "block_new_preorder_wis_lte": -4.5,
    "pea_eligibility_hard_gate": true,
    "identity_quarantine_hard_gate": true,
    "active_scoring_requires_empirical_calibration": true
  },
  "runtime": {
    "priority_action_limit": 300,
    "finnhub_fallback_limit": 120,
    "persist_event_history_days": 730,
    "persist_score_history_days": 730,
    "fail_if_v182_quality_fails": true
  },
  "smart_money_quality_gates": {
    "event_isin_valid_min_pct": 99.0,
    "duplicate_event_max": 0,
    "source_a_event_min_pct": 35.0,
    "max_short_data_age_days": 2,
    "no_lookahead_required": true,
    "shadow_score_final_match_min_pct": 100.0,
    "etf_provider_registry_min_pct": 100.0,
    "calibration_status_required": "STRUCTURAL_CALIBRATED_RC1",
    "max_abs_action_shadow_delta": 5.0,
    "max_abs_etf_shadow_delta": 3.5
  }
}
