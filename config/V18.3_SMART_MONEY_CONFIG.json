  "shorts": {
    "public_threshold_pct": 0.5,
    "notification_threshold_pct": 0.1,
    "delta_sensitivity": 1.0,
    "censored_confidence_multiplier": 0.65
  },
  "tape": {
    "min_volume_z": 1.75,
    "min_dollar_volume_z": 1.5,
    "min_abs_clv": 0.4,
