    "entry_confirmation_states": ["BUY", "STRONG_BUY"],
    "wait_states": ["NEUTRAL"],
    "exit_review_states": ["SELL", "STRONG_SELL"],
    "sell_blocks_new_entry": true,
    "missing_signal_policy": "WAIT_SOURCE_MISSING_NEVER_SELL",
